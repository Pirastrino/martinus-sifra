---
import sifra from "../assets/sifra.png";
import booksData from "../data/books.json";

type BoardContent = {
  imageAlt: string;
  cellAriaLabelPrefix: string;
  backButtonLabel: string;
  hintsHeading: string;
  openShopLabel: string;
  revealFirstHintLabel: string;
  revealNextHintLabel: string;
  revealAnswerLabel: string;
  noAnswerLabel: string;
  noHintsRevealedText: string;
  noHintsAvailableText: string;
  missingTitleText: string;
  missingAuthorText: string;
};

type Book = {
  id: string;
  title: string;
  author: string;
  link: string;
  hints: string[];
};

const columns = 5;
const rows = 8;
const totalCells = columns * rows;
const { content } = Astro.props as { content: BoardContent };

const fallbackBook = (id: string): Book => ({
  id,
  title: "",
  author: "",
  link: "",
  hints: ["", "", ""],
});

const sourceBooks = booksData as Book[];
const booksById = new Map(sourceBooks.map((book) => [book.id, book]));

const books = Array.from({ length: totalCells }, (_, index) => {
  const id = String(index + 1);
  const sourceBook = booksById.get(id);
  const baseBook = fallbackBook(id);

  if (!sourceBook) {
    return baseBook;
  }

  return {
    ...baseBook,
    ...sourceBook,
    hints: Array.isArray(sourceBook.hints)
      ? sourceBook.hints
          .map((hint) => (typeof hint === "string" ? hint : ""))
          .concat(baseBook.hints)
          .slice(0, 3)
      : baseBook.hints,
  };
});
---

<section
  class="mx-auto flex min-h-0 w-full flex-1 items-end justify-center md:flex-none"
>
  <div
    class="relative h-full max-h-full w-auto max-w-full aspect-674/1168 overflow-hidden rounded-2xl border border-white/10 bg-stone-900 shadow-2xl shadow-black/40 md:h-auto md:max-h-none md:w-full md:max-w-[34rem]"
  >
    <div
      data-board-view
      class="relative cursor-pointer transition-opacity duration-400 ease-out data-[state=hidden]:pointer-events-none data-[state=hidden]:opacity-0"
      data-state="visible"
    >
      <img
        src={sifra.src}
        width={sifra.width}
        height={sifra.height}
        alt={content.imageAlt}
        class="h-full w-full select-none object-cover"
        draggable="false"
      />

      <div
        class="absolute inset-0 grid cursor-pointer"
        style={`grid-template-columns: repeat(${columns}, minmax(0, 1fr)); grid-template-rows: repeat(${rows}, minmax(0, 1fr));`}
      >
        {
          books.map((book) => (
            <button
              type="button"
              class="group relative cursor-pointer border border-white/8 bg-black/0 transition hover:bg-amber-200/12 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-amber-300/80"
              data-cell-button
              data-book-id={book.id}
              aria-label={`${content.cellAriaLabelPrefix} ${book.id}`}
            >
              <span class="pointer-events-none absolute left-2 top-2 text-[10px] font-semibold tracking-[0.24em] text-white/65">
                {book.id}
              </span>
            </button>
          ))
        }
      </div>
    </div>

    <div
      data-answer-view
      class="absolute inset-0 flex pointer-events-none opacity-0 transition-opacity duration-400 ease-out data-[state=visible]:pointer-events-auto data-[state=visible]:opacity-100"
      data-state="hidden"
    >
      <div class="relative flex min-h-full w-full flex-col overflow-hidden">
        <img
          src={sifra.src}
          alt=""
          aria-hidden="true"
          class="absolute inset-0 h-full w-full scale-105 object-cover blur-md"
        />
        <div
          class="absolute inset-0 bg-[linear-gradient(180deg,rgba(0,0,0,0.2)_0%,rgba(0,0,0,0)_100%)]"
        >
        </div>
        <div
          class="absolute inset-0 bg-[linear-gradient(180deg,rgba(23,17,22,0.62)_0%,rgba(35,24,32,0.68)_24%,rgba(53,34,45,0.74)_52%,rgba(20,15,19,0.86)_100%)]"
        >
        </div>
        <div
          class="absolute inset-0 bg-[radial-gradient(circle_at_50%_110%,rgba(232,189,143,0.26),transparent_24%),radial-gradient(circle_at_50%_-10%,rgba(128,53,76,0.24),transparent_22%)]"
        >
        </div>

        <div
          class="relative flex min-h-full w-full flex-col overflow-y-auto p-6 sm:p-8"
        >
          <div class="flex justify-end">
            <button
              type="button"
              data-back-button
              class="cursor-pointer rounded-full border border-white/12 bg-white/8 px-3 py-2 text-xs font-medium text-stone-100 transition hover:bg-white/14 focus:outline-none focus:ring-2 focus:ring-amber-300/80 sm:px-4 sm:text-sm"
            >
              {content.backButtonLabel}
            </button>
          </div>

          <div class="mt-4 space-y-2 sm:mt-6">
            <h2
              data-answer-title
              class="text-2xl font-semibold text-white sm:text-4xl"
            >
            </h2>
            <p data-answer-author class="text-sm text-stone-300 sm:text-base">
            </p>
          </div>

          <div class="mt-6">
            <p
              class="text-xs font-semibold uppercase tracking-[0.22em] text-stone-400"
            >
              {content.hintsHeading}
            </p>
            <div
              data-answer-hints
              class="mt-2 space-y-2 text-xs leading-6 text-stone-300 sm:text-sm sm:leading-7"
            >
            </div>
            <button
              type="button"
              data-reveal-button
              class="mt-4 hidden cursor-pointer rounded-full border border-white/12 bg-white/8 px-4 py-2 text-xs font-medium text-stone-100 transition hover:bg-white/14 focus:outline-none focus:ring-2 focus:ring-amber-300/80 disabled:cursor-not-allowed disabled:opacity-50 sm:text-sm"
            ></button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline define:vars={{ books, content }}>
  const buttons = Array.from(document.querySelectorAll("[data-cell-button]"));
  const boardView = document.querySelector("[data-board-view]");
  const answerView = document.querySelector("[data-answer-view]");
  const answerTitle = document.querySelector("[data-answer-title]");
  const answerAuthor = document.querySelector("[data-answer-author]");
  const answerHints = document.querySelector("[data-answer-hints]");
  const revealButton = document.querySelector("[data-reveal-button]");
  const backButton = document.querySelector("[data-back-button]");

  const activeClasses = [
    "bg-amber-200/18",
    "ring-2",
    "ring-inset",
    "ring-amber-200/80",
  ];
  const revealTransition = "filter 220ms ease, opacity 220ms ease";
  let selectedBook = null;
  let revealedHintsCount = 0;
  let answerRevealed = false;

  const getFilledHints = (book) =>
    book.hints.filter((hint) => hint.trim().length > 0);

  const updateBlur = (isRevealed) => {
    if (!answerTitle || !answerAuthor) {
      return;
    }

    answerTitle.classList.toggle("blur-sm", !isRevealed);
    answerTitle.classList.toggle("select-none", !isRevealed);
    answerAuthor.classList.toggle("blur-sm", !isRevealed);
    answerAuthor.classList.toggle("select-none", !isRevealed);
  };

  const setRevealAnimation = (enabled) => {
    if (!answerTitle || !answerAuthor) {
      return;
    }

    const transitionValue = enabled ? revealTransition : "none";
    answerTitle.style.transition = transitionValue;
    answerAuthor.style.transition = transitionValue;
  };

  const updateHints = (book) => {
    if (!answerHints) {
      return;
    }

    const filledHints = getFilledHints(book);
    const visibleHints = filledHints.slice(0, revealedHintsCount);

    if (visibleHints.length === 0) {
      answerHints.innerHTML =
        filledHints.length > 0 ? "" : `<p>${content.noHintsAvailableText}</p>`;
      return;
    }

    answerHints.innerHTML = visibleHints
      .map(
        (hint, index) =>
          `<p><span class="mr-2 inline-block text-amber-200/80">${index + 1}.</span>${hint}</p>`,
      )
      .join("");
  };

  const updateRevealButton = (book) => {
    if (!revealButton) {
      return;
    }

    const filledHints = getFilledHints(book);
    const hasTitle = Boolean(book.title);
    const hasMoreHints = revealedHintsCount < filledHints.length;

    if (hasMoreHints) {
      revealButton.textContent =
        revealedHintsCount === 0
          ? content.revealFirstHintLabel
          : content.revealNextHintLabel;
      revealButton.disabled = false;
      revealButton.classList.remove("hidden");
      return;
    }

    if (!answerRevealed && hasTitle) {
      revealButton.textContent = content.revealAnswerLabel;
      revealButton.disabled = false;
      revealButton.classList.remove("hidden");
      return;
    }

    if (answerRevealed && hasTitle && selectedBook?.link) {
      revealButton.textContent = content.openShopLabel;
      revealButton.disabled = false;
      revealButton.classList.remove("hidden");
      return;
    }

    if (answerRevealed && hasTitle) {
      revealButton.textContent = content.noAnswerLabel;
      revealButton.disabled = true;
      revealButton.classList.remove("hidden");
      return;
    }

    revealButton.textContent = content.noAnswerLabel;
    revealButton.disabled = true;
    revealButton.classList.remove("hidden");
  };

  const updateAnswerView = (book) => {
    const hasAnswer = Boolean(book.title);

    if (!answerTitle || !answerAuthor) {
      return;
    }

    answerTitle.textContent = hasAnswer ? book.title : content.missingTitleText;
    answerAuthor.textContent = book.author || content.missingAuthorText;
    updateBlur(answerRevealed || !hasAnswer);
    updateHints(book);
    updateRevealButton(book);
  };

  const renderBook = (book) => {
    if (!book || !answerTitle || !answerAuthor || !answerHints) {
      return;
    }

    selectedBook = book;
    revealedHintsCount = 0;
    answerRevealed = false;
    setRevealAnimation(false);
    boardView?.setAttribute("data-state", "hidden");
    answerView?.setAttribute("data-state", "visible");
    updateAnswerView(book);
  };

  const setActiveButton = (activeId) => {
    buttons.forEach((button) => {
      button.classList.remove(...activeClasses);

      if (button.dataset.bookId === activeId) {
        button.classList.add(...activeClasses);
      }
    });
  };

  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      const book = books.find((item) => item.id === button.dataset.bookId);
      renderBook(book);
      setActiveButton(button.dataset.bookId ?? "");
    });
  });

  revealButton?.addEventListener("click", () => {
    if (!selectedBook) {
      return;
    }

    if (answerRevealed && selectedBook.link) {
      window.open(selectedBook.link, "_blank", "noopener,noreferrer");
      return;
    }

    const filledHints = getFilledHints(selectedBook);

    if (revealedHintsCount < filledHints.length) {
      revealedHintsCount += 1;
      updateAnswerView(selectedBook);
      return;
    }

    if (selectedBook.title && !answerRevealed) {
      setRevealAnimation(true);
      answerRevealed = true;
      updateAnswerView(selectedBook);
    }
  });

  backButton?.addEventListener("click", () => {
    answerView?.setAttribute("data-state", "hidden");
    boardView?.setAttribute("data-state", "visible");
    selectedBook = null;
    revealedHintsCount = 0;
    answerRevealed = false;
    setRevealAnimation(false);
    setActiveButton("");
  });
</script>

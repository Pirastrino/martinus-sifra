---
import "../styles/global.css";
import SifraBoard from "../components/SifraBoard.astro";
import logo from "../assets/logo.svg";
import sifraPreview from "../assets/sifra.png";

const baseUrl = import.meta.env.BASE_URL;
const assetBaseUrl = baseUrl.endsWith("/") ? baseUrl : `${baseUrl}/`;
const cloudflareAnalyticsToken = import.meta.env
  .PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN;
const productionUrl = "https://pirastrino.github.io/martinus-sifra/";
const canonicalUrl = productionUrl;
const socialImageUrl = new URL(
  sifraPreview.src.replace(/^\//, ""),
  productionUrl,
).toString();
const content = {
  pageTitle: "Knižní šifra",
  pageDescription:
    "Interaktivní knižní šifra inspirovaná světem knih. Objevuj obrázky, odhaluj nápovědy a hádej názvy knih ukrytých v ilustraci.",
  pageKeywords:
    "knižní šifra, Martinus šifra, Martinus knižní šifra, knižní hádanka, knihy, literární kvíz, hádej knihu",
  appButtons: [
    {
      label: "Stáhnout na iOS",
      href: "https://apps.apple.com/cz/app/martinus/id1666794856?l=cs",
      icon: "apple",
    },
    {
      label: "Stáhnout na Android",
      href: "https://play.google.com/store/apps/details?id=sk.martinus.ebooks&hl=cs",
      icon: "google",
    },
  ],
  board: {
    imageAlt: "Knižní šifra",
    cellAriaLabelPrefix: "Pole",
    backButtonLabel: "Zpět",
    hintsHeading: "Nápovědy",
    openShopLabel: "Otevřít na Martinusu",
    revealFirstHintLabel: "Zobrazit nápovědu",
    revealNextHintLabel: "Další nápověda",
    revealAnswerLabel: "Zobrazit odpověď",
    noAnswerLabel: "Zatím bez odpovědi",
    noHintsRevealedText: "Zatím bez odkrytých nápověd.",
    noHintsAvailableText: "Pro tuhle položku zatím nejsou nápovědy.",
    missingTitleText: "Odpověď zatím není doplněná",
    missingAuthorText: "Autor zatím není vyplněný.",
  },
};
---

<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`${assetBaseUrl}favicon.svg`} />
    <link rel="icon" href={`${assetBaseUrl}favicon.ico`} />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <meta name="description" content={content.pageDescription} />
    <meta name="keywords" content={content.pageKeywords} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="cs_CZ" />
    <meta property="og:title" content={content.pageTitle} />
    <meta property="og:description" content={content.pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content={String(sifraPreview.width)} />
    <meta property="og:image:height" content={String(sifraPreview.height)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={content.pageTitle} />
    <meta name="twitter:description" content={content.pageDescription} />
    <meta name="twitter:image" content={socialImageUrl} />
    <title>{content.pageTitle}</title>
    {
      cloudflareAnalyticsToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: cloudflareAnalyticsToken })}
        />
      )
    }
  </head>
  <body class="text-stone-100">
    <main
      class="mx-auto grid h-svh w-full max-w-7xl grid-rows-[auto_minmax(0,1fr)] overflow-hidden px-3 pb-[calc(env(safe-area-inset-bottom)+5.5rem)] pt-3 sm:px-5 sm:py-5 md:flex md:min-h-screen md:flex-col md:justify-center md:px-6 md:py-10 lg:px-8"
    >
      <section
        class="mb-2 flex w-full max-w-3xl flex-col items-center justify-center self-center text-center sm:mb-5 md:mb-8"
      >
        <img
          src={logo.src}
          alt="Martinus Knižní šifra"
          class="mx-auto w-full max-w-[11rem] sm:max-w-[18rem] md:max-w-[24rem]"
        />
        <div
          class="mt-3 flex w-full flex-nowrap items-center justify-center gap-2 px-3 sm:mt-5 sm:gap-3 sm:px-5"
        >
          {
            content.appButtons.map((button) => (
              <a
                href={button.href}
                target="_blank"
                rel="noreferrer"
                class="inline-flex min-w-0 flex-1 items-center justify-center gap-1.5 whitespace-nowrap rounded-md border border-[#bb2a26] bg-[#de3a33] px-3 py-2 text-[9px] font-semibold uppercase tracking-[0.01em] text-white shadow-[inset_0_-3px_0_rgba(0,0,0,0.18)] transition hover:bg-[#e44840] focus:outline-none focus:ring-2 focus:ring-[#ff9e8f]/70 sm:w-auto sm:flex-none sm:gap-2 sm:px-5 sm:py-3 sm:text-sm sm:tracking-[0.04em]"
              >
                {button.icon === "apple" ? (
                  <svg
                    aria-hidden="true"
                    viewBox="0 0 384 512"
                    class="h-3 w-3 shrink-0 fill-current sm:h-4 sm:w-4"
                  >
                    <path d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z" />
                  </svg>
                ) : (
                  <svg
                    aria-hidden="true"
                    viewBox="0 0 488 512"
                    class="h-3 w-3 shrink-0 fill-current sm:h-4 sm:w-4"
                  >
                    <path d="M488 261.8C488 403.3 391.1 504 248 504 110.8 504 0 393.2 0 256S110.8 8 248 8c66.8 0 123 24.5 166.3 64.9l-67.5 64.9C258.5 52.6 94.3 116.6 94.3 256c0 86.5 69.1 156.6 153.7 156.6 98.2 0 135-70.4 140.8-106.9H248v-85.3h236.1c2.3 12.7 3.9 24.9 3.9 41.4z" />
                  </svg>
                )}
                <span>{button.label}</span>
              </a>
            ))
          }
        </div>
      </section>

      <SifraBoard content={content.board} />
    </main>
  </body>
</html>
